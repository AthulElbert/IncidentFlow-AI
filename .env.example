# Integration modes: mock | real
JIRA_MODE=mock
JENKINS_MODE=mock

# Storage backend: json | postgres
STORAGE_BACKEND=json
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentic_support

# PR generation: mock | github
PR_MODE=mock
PR_REPO_SLUG=org/agentic-support
PR_GITHUB_TOKEN=
PR_GITHUB_API_BASE_URL=https://api.github.com
PR_BASE_BRANCH=main
PR_LOCAL_BRANCH_MODE=spec
PR_PATCH_OUTPUT_DIR=generated_patches

# Code change pipeline: spec | sandbox_git
CODE_CHANGE_MODE=spec
CODE_CHANGE_ALLOWED_PATHS=config/,runbooks/
CODE_CHANGE_MAX_LINES=200
CODE_CHANGE_AUTO_COMMIT=false
CODE_CHANGE_AUTO_PUSH=false

# Self-fixing code agent: template | llm
# llm mode investigates CODE_FIX_TARGET_PATH with an LLM and proposes a real fix;
# the fix is re-verified against the safe bounds below before being written to
# disk, and falls back to the static template if no LLM key is configured.
# Requires CODE_CHANGE_MODE=sandbox_git to actually write files.
CODE_FIX_MODE=template
CODE_FIX_TARGET_PATH=faulty_project/app_config.json
CODE_FIX_MAX_LATENCY_MS=300
CODE_FIX_MAX_ERROR_PROBABILITY=0.02

# Scheduler / polling mode
# APM_POLL_MODE: off | poll
APM_POLL_MODE=off
APM_POLL_INTERVAL_SECONDS=30
APM_ALERTS_MODE=mock
APM_ALERTS_BASE_URL=http://localhost:9001
APM_ALERTS_DYNATRACE_TOKEN=
APM_ALERTS_TIMEOUT_SECONDS=10
APM_ALERT_QUEUE_FILE=data/apm_alert_queue.json
SCHEDULER_ACTOR=scheduler-agent
SCHEDULER_DEDUP_FILE=data/processed_alerts.json

# Test evidence pipeline: mock | pytest
TEST_EVIDENCE_MODE=mock
TEST_EVIDENCE_COMMAND=python -m pytest -q tests
TEST_EVIDENCE_TIMEOUT_SECONDS=120

# Triage mode: heuristic | llm
TRIAGE_MODE=heuristic
TRIAGE_CONFIDENCE_FLOOR=0.60

# LLM triage settings (required when TRIAGE_MODE=llm)
# OpenAI-compatible; works with OpenAI or Gemini's free-tier compat endpoint:
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   LLM_MODEL=gemini-flash-latest  (an alias Google keeps pointed at a current
#     free-tier model -- pinned model names like gemini-2.5-flash can get
#     locked out for newer API keys even while still listed, so prefer the alias)
#   LLM_API_KEY=<key from https://aistudio.google.com/apikey>
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=20
LLM_VERIFY_SSL=true

# APM evidence collection mode: mock | http
APM_MODE=mock
APM_BASE_URL=http://localhost:9001
APM_VERIFY_SSL=true
APM_TIMEOUT_SECONDS=10

# Dev evidence thresholds
DEV_MIN_APM_IMPROVEMENT_PCT=5.0
REQUIRE_DEV_SMOKE_TESTS=true

# Authentication / RBAC
# AUTH_MODE: api_key | jwt | hybrid
AUTH_ENABLED=true
AUTH_MODE=api_key

# API key auth (used in api_key/hybrid mode)
VIEWER_API_KEY=viewer-local-key
VIEWER_ACTOR=viewer-user
APPROVER_API_KEY=approver-local-key
APPROVER_ACTOR=approver-user
RELEASE_OPERATOR_API_KEY=release-local-key
RELEASE_OPERATOR_ACTOR=release-operator-user

# JWT auth (used in jwt/hybrid mode)
JWT_SECRET=replace-with-32-plus-char-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=agentic-support
JWT_AUDIENCE=agentic-support-api
JWT_ROLE_CLAIM=role
JWT_ACTOR_CLAIM=sub

# Logging
LOG_LEVEL=INFO

# Policy checks before final prod readiness
MIN_CONFIDENCE_FOR_PROD=0.80
REQUIRE_ZERO_WARNINGS_FOR_PROD=true
# Terminal success states only (e.g. SUCCESS). QUEUED/RUNNING/IN_PROGRESS/UNKNOWN are rejected at startup.
ALLOWED_JENKINS_STATES_FOR_PROD=SUCCESS
# The person who approves a change cannot also promote it. Ignored when AUTH_ENABLED=false.
ENFORCE_SEPARATION_OF_DUTIES=true

# Jenkins build tracking
# How long a request waits for a dev/prod build before returning "in progress"
# (finish it later with POST /v1/changes/{id}/refresh-status).
JENKINS_BUILD_WAIT_SECONDS=20
JENKINS_POLL_INTERVAL_SECONDS=2
# Mock Jenkins: how many polls report RUNNING before the build finishes, and how it finishes.
MOCK_JENKINS_POLLS=1
MOCK_JENKINS_OUTCOME=success

# Alert correlation (scheduler path): alerts for the same service+environment arriving while an
# earlier change is still unapproved and was touched within this many minutes are folded into
# that change instead of opening a new one. 0 disables.
CORRELATION_WINDOW_MINUTES=15

# Agent tool layer (used by the agent workflow; each defaults to a deterministic simulator)
# METRICS_MODE: mock | prometheus   (prometheus works with local_apm_demo at http://localhost:9090)
METRICS_MODE=mock
METRICS_BASE_URL=http://localhost:9090
METRICS_TIMEOUT_SECONDS=10
# LOGS_MODE: mock | file   (file reads a JSONL of {"timestamp","service","level","message"}; needs LOGS_FILE_PATH)
LOGS_MODE=mock
LOGS_FILE_PATH=
# DEPLOY_HISTORY_MODE: mock | changes   (changes = deploys derived from promoted change records)
DEPLOY_HISTORY_MODE=mock
# DEPLOY_TARGET_MODE: mock | jenkins   (dev deploys only; agents can never canary or roll back)
DEPLOY_TARGET_MODE=mock
# Maximum tool calls one agent run may make before it is stopped
TOOL_MAX_CALLS_PER_RUN=40

# Investigator agent (explains an alert from evidence; not yet in the live incident flow)
# INVESTIGATOR_MODE: heuristic | llm
#   heuristic = evidence-based reasoning only. llm = a model may request a few more tool calls and
#   writes the root-cause wording; confidence is ALWAYS computed from the evidence, never by the model.
INVESTIGATOR_MODE=heuristic
# Optional: a different model for the Investigator than LLM_MODEL
INVESTIGATOR_MODEL=
# Escalate to a human below this confidence, or when the top two hypotheses are closer than the margin
INVESTIGATION_MIN_CONFIDENCE=0.60
INVESTIGATION_MIN_MARGIN=0.10
INVESTIGATION_MAX_LLM_STEPS=3

# Verifier agent (independently checks a proposed fix; not yet in the live incident flow)
# DEV_METRICS_MODE: mock | prometheus. "mock" is a simulated dev environment shared with the mock deploy
# target (deploying a branch changes the metrics). With DEPLOY_TARGET_MODE=jenkins you MUST use prometheus,
# otherwise the Verifier would be measuring simulated numbers.
DEV_METRICS_MODE=mock
DEV_METRICS_BASE_URL=
# What the simulated dev environment does when a branch is deployed (demo only):
# resolves | no_effect | partial | regresses_other | deploy_fails
MOCK_DEV_EFFECT=resolves
VERIFIER_DEPLOY_WAIT_SECONDS=120
VERIFIER_POLL_INTERVAL_SECONDS=5
# How long of dev metrics to judge the fix by, and how much the alert metric must improve
VERIFIER_SOAK_MINUTES=10
VERIFIER_MIN_IMPROVEMENT=0.5

# Fixer agent (proposes a change in an isolated worktree; not yet in the live incident flow)
# FIXER_MODE: off | llm. "off" means it never proposes a change. There is no template fallback on purpose:
# a templated change would only give the Verifier something meaningless to verify.
FIXER_MODE=off
FIXER_MODEL=
FIXER_MAX_STEPS=12
# Critic agent (reviews a verified fix for scope creep and risk, and warns the human reviewer)
# CRITIC_MODE: rules | llm. A model can only add concerns; it can never approve or clear a failed check.
CRITIC_MODE=rules
CRITIC_MODEL=

# Real mode must not silently fall back to simulators. Set true ONLY for demos.
ALLOW_MOCK_FALLBACK=false
# Directory (relative to the repo root, or absolute) for incident/change JSON files.
APP_DATA_DIR=data

# Jira (required when JIRA_MODE=real)
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_PROJECT_KEY=SUP
JIRA_EMAIL=your-email@company.com
JIRA_API_TOKEN=your-jira-api-token

# Jenkins (required when JENKINS_MODE=real)
JENKINS_BASE_URL=https://jenkins.company.com
JENKINS_USER=your-jenkins-user
JENKINS_API_TOKEN=your-jenkins-api-token
JENKINS_JOB_SUFFIX=-dev-validation
JENKINS_PROD_JOB_SUFFIX=-prod-deploy
JENKINS_VERIFY_SSL=true
